<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/database_background">

    <TextView
        android:id="@+id/database_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/database_status_bg"
        android:padding="8dp"
        android:text="@string/database_stopped"
        android:textColor="@color/database_status_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/database_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/database_start"
        app:layout_constraintTop_toBottomOf="@id/database_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Entrada de SQL + botao executar -->
    <LinearLayout
        android:id="@+id/database_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/database_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/input_sql"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/database_query"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btn_query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/database_query"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/database_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/database_input_row"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/database_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/database_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>