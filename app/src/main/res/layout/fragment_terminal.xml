<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_background">

    <!-- Barra de status do terminal -->
    <TextView
        android:id="@+id/terminal_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terminal_status_bg"
        android:padding="8dp"
        android:text="@string/terminal_stopped"
        android:textColor="@color/terminal_status_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Saida do terminal -->
    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/terminal_status"
        app:layout_constraintBottom_toTopOf="@id/terminal_input_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/terminal_placeholder"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <!-- Linha de entrada + botao executar -->
    <LinearLayout
        android:id="@+id/terminal_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/terminal_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/terminal_input_bg"
            android:fontFamily="monospace"
            android:hint="@string/terminal_hint"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_execute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/database_query"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>